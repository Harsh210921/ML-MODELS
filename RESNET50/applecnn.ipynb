    "model.eval()\n",
    "with torch.no_grads()\n",
    "accuracy=0\n",
    "correct=0\n",
    "for inputs, labels in test_loader:\n",
    "    output=model(inputs)\n",
    "    result=argmax(output)\n",
    "    if result==labels:\n",
    "        correct+=1\n",
    "accuracy=correct/len(test_loader)\n",
    "print(accuracy)\n",
    "    \n",
    "    "
